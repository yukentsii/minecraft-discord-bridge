# ==========================================================
#              DISCORD BOT CONFIGURATION
# ==========================================================

# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Channel IDs (Enable Developer Mode in Discord -> Right-click channel -> Copy ID)
# Channel where staff review whitelist applications
WHITELIST_REVIEW_CHANNEL_ID=000000000000000000

# Channel where live Minecraft server console logs are streamed & commands executed
CONSOLE_CHANNEL_ID=000000000000000000

# Role IDs (Server Settings -> Roles -> Copy Role ID)
# Role authorized to approve/reject whitelist and run console commands
ADMIN_ROLE_ID=000000000000000000

# Role granted to users when their whitelist request is approved
WHITELIST_ROLE_ID=000000000000000000

# ==========================================================
#           MINECRAFT SERVER INTEGRATION
# ==========================================================

# Absolute or relative path to the Minecraft server's whitelist.json file
MC_WHITELIST_PATH=/path/to/your/minecraft/whitelist.json

# Internal HTTP API address hosted by the Fabric mod (default: http://127.0.0.1:25585)
MC_MOD_API_URL=http://127.0.0.1:25585

# Name of your Minecraft server shown in confirmation DMs
SERVER_NAME=Minecraft Server
